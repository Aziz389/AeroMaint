# Copy this file to .env and replace the fake values. Never commit .env.

# Database
DB_URL=jdbc:mysql://localhost:3306/aeromaint
DB_USERNAME=aeromaint
DB_PASSWORD=change-me

# JWT (use a long random string, at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-string-000000
JWT_EXPIRATION_MS=3600000

# Password set on the seeded demo users (admin, sup.ben, tech.karim...) on first start
DEMO_PASSWORD=change-me-demo
